{
  "$id": "https://stac-extensions.github.io/raster/v2.0.0/schema.json#",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "$comment": "Items",
      "if": {
        "properties": {
          "type": {
            "const": "Feature"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "properties": {
                "$ref": "#/definitions/validate_properties"
              }
            }
          },
          {
            "$ref": "#/definitions/validate_assets"
          }
        ],
        "anyOf": [
          {
            "properties": {
              "properties": {
                "$ref": "#/definitions/require_properties"
              }
            },
            "required": [
              "properties"
            ]
          },
          {
            "$ref": "#/definitions/require_assets"
          }
        ]
      }
    },
    {
      "$comment": "Collections",
      "if": {
        "properties": {
          "type": {
            "const": "Collection"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "$ref": "#/definitions/validate_bands"
          },
          {
            "$ref": "#/definitions/validate_assets"
          },
          {
            "properties": {
              "item_assets": {
                "additionalProperties": {
                  "$ref": "#/definitions/validate_properties"
                }
              }
            }
          },
          {
            "properties": {
              "summaries": {
                "$comment": "We can't properly validate summary objects types (min/max or schemas) yet.",
                "allOf": [
                  {
                    "$ref": "#/definitions/validate_bands"
                  },
                  {
                    "properties": {
                      "raster:bits_per_sample": {
                        "items": {
                          "$ref": "#/definitions/raster:bits_per_sample"
                        },
                        "type": [
                          "array",
                          "object"
                        ]
                      }
                    }
                  },
                  {
                    "properties": {
                      "raster:sampling": {
                        "items": {
                          "$ref": "#/definitions/raster:sampling"
                        },
                        "type": [
                          "array",
                          "object"
                        ]
                      }
                    }
                  },
                  {
                    "properties": {
                      "raster:scale": {
                        "items": {
                          "$ref": "#/definitions/raster:scale"
                        },
                        "type": [
                          "array",
                          "object"
                        ]
                      }
                    }
                  },
                  {
                    "properties": {
                      "raster:offset": {
                        "items": {
                          "$ref": "#/definitions/raster:offset"
                        },
                        "type": [
                          "array",
                          "object"
                        ]
                      }
                    }
                  },
                  {
                    "properties": {
                      "raster:spatial_resolution": {
                        "items": {
                          "$ref": "#/definitions/raster:spatial_resolution"
                        },
                        "type": [
                          "array",
                          "object"
                        ]
                      }
                    }
                  },
                  {
                    "properties": {
                      "raster:histogram": {
                        "items": {
                          "$ref": "#/definitions/raster:histogram"
                        },
                        "type": [
                          "array",
                          "object"
                        ]
                      }
                    }
                  }
                ],
                "type": "object"
              }
            }
          }
        ],
        "anyOf": [
          {
            "$ref": "#/definitions/require_in_bands"
          },
          {
            "$ref": "#/definitions/require_assets"
          },
          {
            "properties": {
              "item_assets": {
                "$ref": "#/definitions/asset_contains"
              }
            },
            "required": [
              "item_assets"
            ]
          },
          {
            "properties": {
              "summaries": {
                "$ref": "#/definitions/require_properties"
              }
            },
            "required": [
              "summaries"
            ]
          }
        ]
      }
    }
  ],
  "definitions": {
    "asset_contains": {
      "not": {
        "additionalProperties": {
          "not": {
            "$ref": "#/definitions/require_properties"
          }
        }
      },
      "type": "object"
    },
    "fields": {
      "additionalProperties": false,
      "patternProperties": {
        "^(?!raster:)": {}
      },
      "properties": {
        "raster:bits_per_sample": {
          "$ref": "#/definitions/raster:bits_per_sample"
        },
        "raster:histogram": {
          "$ref": "#/definitions/raster:histogram"
        },
        "raster:offset": {
          "$ref": "#/definitions/raster:offset"
        },
        "raster:sampling": {
          "$ref": "#/definitions/raster:sampling"
        },
        "raster:scale": {
          "$ref": "#/definitions/raster:scale"
        },
        "raster:spatial_resolution": {
          "$ref": "#/definitions/raster:spatial_resolution"
        }
      },
      "type": "object"
    },
    "raster:bits_per_sample": {
      "title": "The actual number of bits used for this band",
      "type": "integer"
    },
    "raster:histogram": {
      "additionalItems": false,
      "additionalProperties": false,
      "properties": {
        "buckets": {
          "items": {
            "title": "number of pixels in the bucket",
            "type": "integer"
          },
          "minItems": 3,
          "title": "distribution buckets",
          "type": "array"
        },
        "count": {
          "title": "number of buckets",
          "type": "number"
        },
        "max": {
          "title": "Maximum value of the buckets",
          "type": "number"
        },
        "min": {
          "title": "Minimum value of the buckets",
          "type": "number"
        }
      },
      "required": [
        "count",
        "min",
        "max",
        "buckets"
      ],
      "title": "Histogram",
      "type": "object"
    },
    "raster:offset": {
      "title": "number to be added to the pixel value to transform into the value",
      "type": "number"
    },
    "raster:sampling": {
      "enum": [
        "area",
        "point"
      ],
      "title": "Pixel sampling in the band",
      "type": "string"
    },
    "raster:scale": {
      "title": "multiplicator factor of the pixel value to transform into the value",
      "type": "number"
    },
    "raster:spatial_resolution": {
      "title": "Average spatial resolution (in meters) of the pixels in the band",
      "type": "number"
    },
    "require_assets": {
      "properties": {
        "assets": {
          "$ref": "#/definitions/asset_contains"
        }
      },
      "required": [
        "assets"
      ]
    },
    "require_fields": {
      "anyOf": [
        {
          "required": [
            "raster:bits_per_sample"
          ]
        },
        {
          "required": [
            "raster:sampling"
          ]
        },
        {
          "required": [
            "raster:scale"
          ]
        },
        {
          "required": [
            "raster:offset"
          ]
        },
        {
          "required": [
            "raster:spatial_resolution"
          ]
        },
        {
          "required": [
            "raster:histogram"
          ]
        }
      ]
    },
    "require_in_bands": {
      "properties": {
        "bands": {
          "contains": {
            "$ref": "#/definitions/require_fields"
          },
          "type": "array"
        }
      },
      "required": [
        "bands"
      ]
    },
    "require_properties": {
      "anyOf": [
        {
          "$ref": "#/definitions/require_fields"
        },
        {
          "$ref": "#/definitions/require_in_bands"
        }
      ]
    },
    "validate_assets": {
      "properties": {
        "assets": {
          "additionalProperties": {
            "$ref": "#/definitions/validate_properties"
          }
        }
      }
    },
    "validate_bands": {
      "properties": {
        "bands": {
          "items": {
            "$ref": "#/definitions/fields"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "validate_properties": {
      "allOf": [
        {
          "$ref": "#/definitions/fields"
        },
        {
          "$ref": "#/definitions/validate_bands"
        }
      ]
    }
  },
  "description": "STAC Raster Extension for STAC Items and STAC Collections.",
  "properties": {
    "stac_extensions": {
      "contains": {
        "const": "https://stac-extensions.github.io/raster/v2.0.0/schema.json"
      },
      "type": "array"
    }
  },
  "required": [
    "stac_extensions",
    "type"
  ],
  "title": "Raster Extension",
  "type": "object"
}
