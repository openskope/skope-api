{
  "$id": "https://schemas.stacspec.org/v1.1.0/collection-spec/json-schema/collection.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "$ref": "#/definitions/collection"
    },
    {
      "$ref": "../../item-spec/json-schema/common.json"
    }
  ],
  "definitions": {
    "collection": {
      "$comment": "title, description, keywords, providers and license is validated through the common metadata.",
      "description": "These are the fields specific to a STAC Collection.",
      "properties": {
        "assets": {
          "$ref": "../../item-spec/json-schema/item.json#/definitions/assets"
        },
        "extent": {
          "properties": {
            "spatial": {
              "properties": {
                "bbox": {
                  "items": {
                    "items": {
                      "type": "number"
                    },
                    "oneOf": [
                      {
                        "maxItems": 4,
                        "minItems": 4
                      },
                      {
                        "maxItems": 6,
                        "minItems": 6
                      }
                    ],
                    "title": "Spatial extent",
                    "type": "array"
                  },
                  "oneOf": [
                    {
                      "maxItems": 1,
                      "minItems": 1
                    },
                    {
                      "minItems": 3
                    }
                  ],
                  "title": "Spatial extents",
                  "type": "array"
                }
              },
              "required": [
                "bbox"
              ],
              "title": "Spatial extent object",
              "type": "object"
            },
            "temporal": {
              "properties": {
                "interval": {
                  "items": {
                    "items": {
                      "format": "date-time",
                      "pattern": "(\\+00:00|Z)$",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "maxItems": 2,
                    "minItems": 2,
                    "title": "Temporal extent",
                    "type": "array"
                  },
                  "minItems": 1,
                  "title": "Temporal extents",
                  "type": "array"
                }
              },
              "required": [
                "interval"
              ],
              "title": "Temporal extent object",
              "type": "object"
            }
          },
          "required": [
            "spatial",
            "temporal"
          ],
          "title": "Extents",
          "type": "object"
        },
        "id": {
          "minLength": 1,
          "title": "Identifier",
          "type": "string"
        },
        "item_assets": {
          "additionalProperties": {
            "allOf": [
              {
                "minProperties": 2,
                "properties": {
                  "description": {
                    "title": "Asset description",
                    "type": "string"
                  },
                  "href": {
                    "not": {},
                    "title": "Disallow href"
                  },
                  "roles": {
                    "items": {
                      "type": "string"
                    },
                    "title": "Asset roles",
                    "type": "array"
                  },
                  "title": {
                    "title": "Asset title",
                    "type": "string"
                  },
                  "type": {
                    "title": "Asset type",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              {
                "$ref": "../../item-spec/json-schema/common.json"
              }
            ]
          }
        },
        "links": {
          "$ref": "../../item-spec/json-schema/item.json#/definitions/links"
        },
        "stac_extensions": {
          "items": {
            "format": "iri",
            "title": "Reference to a JSON Schema",
            "type": "string"
          },
          "title": "STAC extensions",
          "type": "array",
          "uniqueItems": true
        },
        "stac_version": {
          "const": "1.1.0",
          "title": "STAC version",
          "type": "string"
        },
        "summaries": {
          "$ref": "#/definitions/summaries"
        },
        "type": {
          "const": "Collection",
          "title": "Type of STAC entity"
        }
      },
      "required": [
        "stac_version",
        "type",
        "id",
        "description",
        "license",
        "extent",
        "links"
      ],
      "title": "STAC Collection",
      "type": "object"
    },
    "summaries": {
      "additionalProperties": {
        "anyOf": [
          {
            "allOf": [
              {
                "$ref": "http://json-schema.org/draft-07/schema"
              }
            ],
            "minProperties": 1,
            "title": "JSON Schema",
            "type": "object"
          },
          {
            "properties": {
              "maximum": {
                "title": "Maximum value",
                "type": [
                  "number",
                  "string"
                ]
              },
              "minimum": {
                "title": "Minimum value",
                "type": [
                  "number",
                  "string"
                ]
              }
            },
            "required": [
              "minimum",
              "maximum"
            ],
            "title": "Range",
            "type": "object"
          },
          {
            "items": {
              "description": "For each field only the original data type of the property can occur (except for arrays), but we can't validate that in JSON Schema yet. See the sumamry description in the STAC specification for details."
            },
            "minItems": 1,
            "title": "Set of values",
            "type": "array"
          }
        ]
      },
      "type": "object"
    }
  },
  "description": "This object represents Collections in a SpatioTemporal Asset Catalog.",
  "title": "STAC Collection Specification"
}
