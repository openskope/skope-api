{
  "$id": "https://schemas.stacspec.org/v1.1.0/item-spec/json-schema/datetime.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "dependencies": {
    "end_datetime": {
      "required": [
        "start_datetime"
      ]
    },
    "start_datetime": {
      "required": [
        "end_datetime"
      ]
    }
  },
  "properties": {
    "created": {
      "format": "date-time",
      "pattern": "(\\+00:00|Z)$",
      "title": "Creation Time",
      "type": "string"
    },
    "datetime": {
      "description": "The searchable date/time of the data, in UTC (Formatted in RFC 3339) ",
      "format": "date-time",
      "pattern": "(\\+00:00|Z)$",
      "title": "Date and Time",
      "type": [
        "string",
        "null"
      ]
    },
    "end_datetime": {
      "description": "The searchable end date/time of the data, in UTC (Formatted in RFC 3339) ",
      "format": "date-time",
      "pattern": "(\\+00:00|Z)$",
      "title": "End Date and Time",
      "type": "string"
    },
    "start_datetime": {
      "description": "The searchable start date/time of the data, in UTC (Formatted in RFC 3339) ",
      "format": "date-time",
      "pattern": "(\\+00:00|Z)$",
      "title": "Start Date and Time",
      "type": "string"
    },
    "updated": {
      "format": "date-time",
      "pattern": "(\\+00:00|Z)$",
      "title": "Last Update Time",
      "type": "string"
    }
  },
  "title": "Date and Time Fields",
  "type": "object"
}
