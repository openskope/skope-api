FROM ghcr.io/developmentseed/titiler:latest

COPY titiler_custom/ /titiler_custom/
COPY deploy/display/palettes.yml /titiler_custom/palettes.yml

USER root
RUN python3 /titiler_custom/build_colormaps.py
USER 1000

WORKDIR /titiler_custom

# Tile reads don't run in parallel on threads, so each worker process serves
# one tile at a time. The host's 8 vCPUs are shared with the API's workers.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "80", "--workers", "2"]
