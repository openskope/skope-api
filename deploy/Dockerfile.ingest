# syntax=docker/dockerfile:1
# Pinned by digest: release bytes depend on the GDAL build (REL-009).
# This image's Python bindings support the locked NumPy 2 runtime.
ARG GDAL_IMAGE=ghcr.io/osgeo/gdal:ubuntu-small-3.13.3@sha256:64250faf833c06d4b21afce4c27190039ba7ab58d70f0eebc87cf77d929c0b40
FROM ${GDAL_IMAGE} AS runtime

# Part of a prepared source's toolchain record (OBS-015).
ARG GDAL_IMAGE
ENV SKOPE_RELEASE_GDAL_IMAGE=${GDAL_IMAGE}

COPY --from=ghcr.io/astral-sh/uv:0.13.8 /uv /bin/

ENV UV_SYSTEM_PYTHON=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /ingest

# Locked dependencies install before the code is copied, so a code change
# reuses this layer and only reinstalls the project itself.
COPY timeseries/ingest/pyproject.toml timeseries/ingest/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv export --format requirements.txt --no-dev --no-emit-project --locked --no-hashes --output-file requirements.lock && \
    uv pip install --system --break-system-packages -r requirements.lock

COPY timeseries/ingest/src ./src
COPY timeseries/ingest/scripts ./scripts
COPY timeseries/ingest/README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --break-system-packages --no-deps .

# The runtime operator may have any uid/gid; copied scripts stay root-owned.
RUN chmod -R a+rX /ingest

CMD ["skope-release", "--help"]

FROM runtime AS test

RUN --mount=type=cache,target=/root/.cache/uv \
    uv export --format requirements.txt --only-group dev --no-emit-project --locked --no-hashes --output-file requirements-dev.lock && \
    uv pip install --system --break-system-packages -r requirements-dev.lock

COPY timeseries/ingest/tests ./tests
COPY tests/contracts ./tests/contracts
COPY timeseries/ingest/datasets ./datasets
RUN chmod -R a+rX ./tests ./datasets

CMD ["pytest", "tests"]
