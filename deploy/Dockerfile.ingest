# Pinned by digest: release bytes depend on the GDAL build (REL-009).
FROM ghcr.io/osgeo/gdal:ubuntu-small-3.12.0@sha256:9c3f7d8caf2a36762385d4868e198660a90b0c896f86b01fcab26953770b794e AS runtime

COPY --from=ghcr.io/astral-sh/uv:0.12.13 /uv /uvx /bin/

ENV UV_SYSTEM_PYTHON=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /ingest

# Locked dependencies install before the code is copied, so a code change
# reuses this layer and only reinstalls the project itself.
COPY timeseries/ingest/pyproject.toml timeseries/ingest/uv.lock ./
RUN uv export --format requirements.txt --no-dev --no-emit-project --locked --no-hashes --output-file requirements.lock && \
    uv pip install --system --break-system-packages --no-cache -r requirements.lock

COPY timeseries/ingest/src ./src
COPY timeseries/ingest/README.md ./
COPY timeseries/ingest/metadata.yml ./metadata.yml
COPY timeseries/ingest/legacy-metadata.yml ./legacy-metadata.yml
COPY timeseries/ingest/manifests ./manifests
RUN uv pip install --system --break-system-packages --no-cache --no-deps .

CMD ["cog-stac-pipeline"]

FROM runtime AS test

RUN uv export --format requirements.txt --only-group dev --no-emit-project --locked --no-hashes --output-file requirements-dev.lock && \
    uv pip install --system --break-system-packages --no-cache -r requirements-dev.lock

COPY timeseries/ingest/tests ./tests
COPY tests/contracts ./tests/contracts

CMD ["pytest", "tests"]
